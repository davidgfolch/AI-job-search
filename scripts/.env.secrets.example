# =============================================================================
# Account Credentials (SECRETS — keep these private!)
# =============================================================================

# Scrapper - LinkedIn
SCRAPPER_LINKEDIN_EMAIL=xxxxx@xxxxx.com
SCRAPPER_LINKEDIN_PWD=yyyyy

# Scrapper - InfoJobs
SCRAPPER_INFOJOBS_EMAIL=xxxxx@xxxxx.com
SCRAPPER_INFOJOBS_PWD=yyyyy

# Scrapper - Glassdoor (uses Indeed email for OTP login, no separate email needed)
# SCRAPPER_GLASSDOOR_EMAIL is not used — GlassdoorAuthenticator reads SCRAPPER_INDEED_EMAIL instead
# SCRAPPER_GLASSDOOR_EMAIL=xxxxx@xxxxx.com

# Scrapper - TecnoEmpleo
SCRAPPER_TECNOEMPLEO_EMAIL=xxxxx@xxxxx.com
SCRAPPER_TECNOEMPLEO_PWD=yyyyy

# Scrapper - Indeed
SCRAPPER_INDEED_EMAIL=xxxxx@xxxxx.com
SCRAPPER_INDEED_PWD=yyyyy

# Gmail for 2FA (Indeed Login) - https://myaccount.google.com/apppasswords
GMAIL_EMAIL=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password

# MongoDB
MONGO_USERNAME=root
MONGO_PASSWORD=rootPass

# =============================================================================
# AI Provider API Keys (optional, commented by default)
# =============================================================================
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-...   # https://openrouter.ai/keys (free :free models)
# GEMINI_API_KEY=...          # https://aistudio.google.com/apikey (free tier)
# GROQ_API_KEY=...            # https://console.groq.com/keys (free tier)
# CEREBRAS_API_KEY=...        # https://cloud.cerebras.ai/ (free tier)
# HF_TOKEN=...                # https://huggingface.co/settings/tokens (Inference Providers)

